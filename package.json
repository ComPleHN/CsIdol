{
  "name": "cs-idol",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"node scripts/data-api.mjs\" \"next dev\"",
    "data-api": "node scripts/data-api.mjs",
    "build": "next build",
    "build:gh": "cross-env NEXT_PUBLIC_BASE_PATH=/CsIdol next build",
